{
  "name": "mua",
  "version": "1.0.0",
  "description": "Production-ready Next.js 16+ starter built with Tailwind CSS 4 and TypeScript.",
  "author": {
    "name": "Rishi Singh",
    "email": "muastartup@gmail.com",
    "url": "https://mua.co.in"
  },
  "license": "MIT",
  "homepage": "https://mua.co.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/MUA-India/mua.git"
  },
  "bugs": {
    "url": "https://github.com/MUA-India/mua/issues"
  },
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "analyze": "cross-env ANALYZE=true next build --webpack && open .next/analyze/nodejs.html",
    "clean": "rimraf .next",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint": "eslint . --ext js,ts,tsx --cache",
    "lint:fix": "eslint . --ext js,ts,tsx --fix --cache && prettier --write .",
    "lint:ci": "eslint . --ext js,ts,tsx --max-warnings=0 && prettier --check .",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "commit": "cz"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "keywords": [
    "virastack",
    "nextjs-boilerplate",
    "nextjs-starter",
    "react-boilerplate",
    "fullstack-template",
    "react",
    "nextjs",
    "cursor-rules",
    "clean-architecture",
    "typescript",
    "tantack-query",
    "tailwindcss",
    "shadcn-ui",
    "dx"
  ],
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@hookform/resolvers": "^5.4.0",
    "@next/bundle-analyzer": "^16.2.7",
    "@next/third-parties": "^16.2.7",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-query-devtools": "^5.100.14",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.3",
    "js-cookie": "^3.0.8",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "next-auth": "^4.24.14",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "react-wrap-balancer": "^1.1.1",
    "resend": "^6.12.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "usehooks-ts": "^3.1.1",
    "webpack": "^5.107.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/cz-commitlint": "^21.0.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "commitizen": "^4.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10",
    "eslint-config-next": "16.2.7",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "knip": "^6.15.0",
    "lint-staged": "^17.0.7",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prisma": "^7.8.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6"
  }
}
